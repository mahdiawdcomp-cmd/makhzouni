DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=5000
INITIAL_ADMIN_NAME="مدير النظام"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
JWT_SECRET="replace-with-256-bit-random-secret"
JWT_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS=10
ENABLE_WHATSAPP=false
CHROME_PATH=""
# Use the official Meta WhatsApp Cloud API instead of QR/WhatsApp Web.
# Set WHATSAPP_PROVIDER=cloud in production when these values are configured.
WHATSAPP_PROVIDER=web
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_GRAPH_VERSION="v20.0"
API_RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15_MINUTES=5
REFRESH_RATE_LIMIT_PER_MINUTE=20

# ── Green API inbound webhook ────────────────────────────────────────────────
# REQUIRED to enable POST /api/public/whatsapp/incoming-webhook. The endpoint
# drives outbound WhatsApp replies, so it fails CLOSED: with this unset the
# webhook silently ignores every request. Append ?secret=<value> to the URL you
# register in the Green API console (or send it as the x-webhook-secret header).
GREENAPI_WEBHOOK_SECRET=

# Absolute origin of THIS backend, used for media links embedded in Instagram /
# Telegram posts and the keep-alive ping. Falls back to the platform's own
# injected domain (RAILWAY_PUBLIC_DOMAIN). Never point it at another tenant.
BACKEND_PUBLIC_URL=

# ═══════════════════════════════════════════════════════════════════════════
# Everything below was read by the code but undocumented. A new tenant
# deployed without these fails silently rather than loudly, so treat the
# REQUIRED ones as part of provisioning.
# ═══════════════════════════════════════════════════════════════════════════

# ── Multi-tenant / licensing ────────────────────────────────────────────────
# REQUIRED in SaaS mode. Identifies this deployment to the Super Admin API;
# it is a SERVER-side value and is never read from the request.
TENANT_ID=
SUPER_ADMIN_API_URL=
SUPER_ADMIN_API_KEY=
# Offline licence verification (desktop/standalone builds).
LICENSE_KEY=
LICENSE_PRIVATE_KEY=

# ── Public URLs ─────────────────────────────────────────────────────────────
# This backend's own absolute origin, used for media links embedded in
# Instagram/Telegram posts and for the keep-alive ping. Falls back to the
# platform's injected RAILWAY_PUBLIC_DOMAIN. NEVER point it at another tenant.
BACKEND_PUBLIC_URL=
# This tenant's own web app origin (Instagram OAuth return, etc.).
FRONTEND_PUBLIC_URL=
# Fallback public catalog URL when the tenant has not set catalogPublicUrl in
# the app settings. Leave blank rather than borrowing another shop's link.
PUBLIC_CATALOG_URL=
# Injected by Railway; read only as a tenant-neutral fallback for the above.
RAILWAY_PUBLIC_DOMAIN=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call this API.
ALLOWED_ORIGIN=

# ── Secrets ─────────────────────────────────────────────────────────────────
# REQUIRED. Encrypts provider credentials stored in the settings table.
CREDENTIALS_ENCRYPTION_KEY=
# Grants unattended access to the backup download endpoints. Send it as the
# X-Backup-Secret header (the ?secret= query form still works but is masked in
# logs). Leave blank to require an admin session instead.
BACKUP_SECRET=
# Where scheduled backup archives are written.
BACKUP_DIR=

# ── WhatsApp: Meta Cloud API ────────────────────────────────────────────────
# App Secret is REQUIRED for inbound messages: the webhook FAILS CLOSED and
# ignores every payload while it is unset.
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Session storage path for the legacy whatsapp-web.js provider.
WHATSAPP_AUTH_PATH=

# ── WhatsApp: Green API (legacy provider) ───────────────────────────────────
GREENAPI_BASE_URL=
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=

# ── Instagram ───────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Web push (arrival notifications) ────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── AI (voice commands, OCR, retail chat) ───────────────────────────────────
GROQ_API_KEY=

# ── Scheduling / locale ─────────────────────────────────────────────────────
# Shop timezone. Drives EVERY day boundary in reports — get this wrong and
# "today" is off by hours. Defaults to Asia/Baghdad.
ASSISTANT_TIMEZONE=Asia/Baghdad
# Keep-alive ping window (prevents the host idling the process out).
KEEP_ALIVE_ENABLED=
KEEP_ALIVE_TIMEZONE=
KEEP_ALIVE_START_TIME=
KEEP_ALIVE_END_TIME=
# Legacy whole-hour form, honoured when the *_TIME pair above is unset.
KEEP_ALIVE_START_HOUR=
KEEP_ALIVE_END_HOUR=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
