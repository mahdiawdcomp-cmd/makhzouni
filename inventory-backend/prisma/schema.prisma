  usageLimit     Int?          @map("usage_limit")
  usedCount      Int           @default(0) @map("used_count")
  active         Boolean       @default(true)
  description    String?
  // بند ٧ — distinguishes an auto-issued first-order welcome coupon from any
  // other manually-created promo code, so the report can filter cleanly.
  // Null for every code created before this field existed / created manually.
  source         String?
  // "تذكير قبل الانتهاء بيوم" dedupe — set once the reminder sends so the
  // daily cron never re-sends it on a later run.
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

