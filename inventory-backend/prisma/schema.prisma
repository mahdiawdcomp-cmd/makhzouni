// A customer reached the public catalog's checkout FORM (the earliest point a
// phone number exists — cart items themselves are pure client-side React state
// until then, see RetailShopPage.tsx) but the window closed before
// submitPublicRetailOrder succeeded. completedAt is set explicitly by the
// frontend right after a successful order placement (not inferred), so the
// abandoned-cart cron only needs to check completedAt/notifiedAt IS NULL past
// a timeout — no fragile matching against RetailOrder rows by phone/time.
model CatalogCartSession {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  itemCount   Int       @map("item_count")
  totalValue  Decimal   @default(0) @map("total_value") @db.Decimal(12, 2)
  startedAt   DateTime  @default(now()) @map("started_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  notifiedAt  DateTime? @map("notified_at")

  @@index([phone])
  @@index([completedAt, notifiedAt])
  @@map("catalog_cart_sessions")
}

// A public-catalog search that matched zero products (search itself is
// client-side filtering over an already-fetched product list — see
// RetailShopPage.tsx — so this is reported explicitly by the frontend, not
// inferred server-side). Aggregated into a top-missed-searches report.
model CatalogSearchMiss {
  id        String   @id @default(uuid()) @db.Uuid
  query     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([query])
  @@map("catalog_search_misses")
}

// ── Inventory Stocktake ──────────────────────────────────────────────────────

model StocktakeSession {
  id          String                 @id @default(uuid()) @db.Uuid
  publicToken String                 @unique @map("public_token")
  branchId    String?                @map("branch_id") @db.Uuid
  branch      Branch?                @relation(fields: [branchId], references: [id])
  status      StocktakeSessionStatus @default(OPEN)
  notes       String?
  createdBy   String                 @map("created_by") @db.Uuid
  creator     User                   @relation(fields: [createdBy], references: [id])
  items       StocktakeItem[]
  createdAt   DateTime               @default(now()) @map("created_at")
  closedAt    DateTime?              @map("closed_at")
  // Who closed the session: an admin user id, or "PUBLIC_WORKER" when closed
  // from the public worker link.
  closedBy    String?                @map("closed_by")
  // Soft-delete: archived sessions are hidden from the admin list. Approved
  // quantities and StockMovement rows are never reverted by archiving.
  archivedAt  DateTime?              @map("archived_at")

  @@index([branchId])
  @@index([createdBy])
  @@index([status])
  @@map("stocktake_sessions")
}

model StocktakeItem {
  id             String                  @id @default(uuid()) @db.Uuid
  sessionId      String                  @map("session_id") @db.Uuid
  session        StocktakeSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId      String                  @map("product_id") @db.Uuid
  product        Product                 @relation(fields: [productId], references: [id])
  productName    String                  @map("product_name")
  systemQty      Int                     @map("system_qty")
  actualQty      Int?                    @map("actual_qty")
  variance       Int?
  notes          String?
  approvalStatus StocktakeApprovalStatus @default(PENDING) @map("approval_status")
  approvedQty    Int?                    @map("approved_qty")
  // Required classification for WHY the variance happened, captured at
  // approval time. lossId links to the stock_losses row that gives the
  // variance a cost value (LOSS reduces net profit, GAIN adds to it) —
  // see approveStocktakeItem(). Both null for legacy rows (pre-dates this)
  // and for zero-variance approvals (nothing to record).
  reason         LossReason?
  lossId         String?                 @map("loss_id") @db.Uuid
  loss           StockLoss?              @relation("StocktakeItemLoss", fields: [lossId], references: [id])

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([approvalStatus])
  @@index([lossId])
  @@map("stocktake_items")
}

// ── جدولة الجرد الذكي (scheduled smart cycle count) ───────────────────────────
// Fully independent from StocktakeSession/StocktakeItem above: separate
// tables, separate service/routes/page. Never read or written by the manual
// stocktake flow, and vice versa.
model CycleCountSession {
  id           String                  @id @default(uuid()) @db.Uuid
  warehouseId  String                  @map("warehouse_id") @db.Uuid
  warehouse    Branch                  @relation(fields: [warehouseId], references: [id])
  status       CycleCountSessionStatus @default(OPEN)
  strategy     CycleCountStrategy
  itemLimit    Int                     @map("item_limit")
  scheduledFor DateTime?               @map("scheduled_for")
  source       CycleCountSessionSource @default(MANUAL)
  // Worker counting link (like StocktakeSession.publicToken, but a separate
  // column/feature) — no login required, systemQty is never exposed to it.
  publicToken  String?                 @unique @map("public_token")
  createdBy    String                  @map("created_by") @db.Uuid
  creator      User                    @relation("CycleCountSessionCreatedBy", fields: [createdBy], references: [id])
  items        CycleCountItem[]
  notes        String?
  createdAt    DateTime                @default(now()) @map("created_at")
  submittedAt  DateTime?               @map("submitted_at")
  closedAt     DateTime?               @map("closed_at")

  @@index([warehouseId])
  @@index([status])
  @@index([createdBy])
  @@map("cycle_count_sessions")
}

model CycleCountItem {
  id             String                   @id @default(uuid()) @db.Uuid
  sessionId      String                   @map("session_id") @db.Uuid
  session        CycleCountSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId      String                   @map("product_id") @db.Uuid
  product        Product                  @relation(fields: [productId], references: [id])
  systemQty      Int                      @map("system_qty")
  actualQty      Int?                     @map("actual_qty")
  variance       Int?
  approvalStatus CycleCountApprovalStatus @default(PENDING) @map("approval_status")
  approvedQty    Int?                     @map("approved_qty")
  approvedBy     String?                  @map("approved_by") @db.Uuid
  approver       User?                    @relation("CycleCountItemApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?                @map("approved_at")
  notes          String?
  // Same purpose as StocktakeItem.reason/lossId above — see that comment.
  reason         LossReason?
  lossId         String?                  @map("loss_id") @db.Uuid
  loss           StockLoss?               @relation("CycleCountItemLoss", fields: [lossId], references: [id])

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
  @@index([approvalStatus])
  @@index([lossId])
  @@map("cycle_count_items")
}

// Landed-Cost Excel Import: upload -> parse -> preview (nothing persisted yet)
// -> confirm pricing (persists batch as DRAFT_PRICED) -> per-item review
// (link/create/skip, REVIEWING_ITEMS) -> final confirm creates a real
// PURCHASE invoice via the existing invoice.service.createInvoice flow, which
// is the only thing that ever writes stock. This model never touches
// ProductWarehouseStock/StockMovement directly.
model LandedCostImportBatch {
  id                 String                     @id @default(uuid()) @db.Uuid
  invoiceNumber      String?                    @map("invoice_number")
  supplier           String?
  allocationMethod   LandedCostAllocationMethod @default(BY_VALUE) @map("allocation_method")
  totalExtraCost     Decimal                    @default(0) @map("total_extra_cost") @db.Decimal(12, 2)
  freight            Decimal                    @default(0) @db.Decimal(12, 2)
  customs            Decimal                    @default(0) @db.Decimal(12, 2)
  localTransport     Decimal                    @default(0) @map("local_transport") @db.Decimal(12, 2)
  unloading          Decimal                    @default(0) @db.Decimal(12, 2)
  commission         Decimal                    @default(0) @db.Decimal(12, 2)
  otherCosts         Decimal                    @default(0) @map("other_costs") @db.Decimal(12, 2)
  note               String?
  status             LandedCostBatchStatus      @default(DRAFT_PRICED)
  originalFileName   String?                    @map("original_file_name")
  // China order pricing inputs (fixed-template flow). Local to this batch —
  // deliberately NOT a general currency/exchange-rate system.
  cbmPriceUsd        Decimal?                   @map("cbm_price_usd") @db.Decimal(12, 4)
  officePercent      Decimal?                   @map("office_percent") @db.Decimal(6, 3)
  cnyPerUsd          Decimal?                   @map("cny_per_usd") @db.Decimal(12, 4)
  usdToIqd           Decimal?                   @map("usd_to_iqd") @db.Decimal(12, 4)
  purchaseInvoiceId  String?                    @map("purchase_invoice_id") @db.Uuid
  purchaseInvoice    Invoice?                   @relation(fields: [purchaseInvoiceId], references: [id])
  // Held for arrival: what the admin already decided when they said the goods
  // had not landed. Replayed unchanged when they press «وصلت», so the answer
  // to «على منو الفاتورة» is given once, not twice.
  expectedArrivalAt  DateTime?                  @map("expected_arrival_at")
  arrivalSupplierId  String?                    @map("arrival_supplier_id") @db.Uuid
  arrivalWarehouseId String?                    @map("arrival_warehouse_id") @db.Uuid
  arrivalPaymentType PaymentType?               @map("arrival_payment_type")
  arrivalPaidAmount  Decimal?                   @map("arrival_paid_amount") @db.Decimal(12, 2)
  createdBy          String                     @map("created_by") @db.Uuid
  creator            User                       @relation("LandedCostBatchCreatedBy", fields: [createdBy], references: [id])
  appliedBy          String?                    @map("applied_by") @db.Uuid
  applier            User?                      @relation("LandedCostBatchAppliedBy", fields: [appliedBy], references: [id])
  createdAt          DateTime                   @default(now()) @map("created_at")
  appliedAt          DateTime?                  @map("applied_at")
  items              LandedCostImportItem[]

  @@index([createdBy])
  @@index([status])
  @@map("landed_cost_import_batches")
}

model LandedCostImportItem {
  id                  String                @id @default(uuid()) @db.Uuid
  batchId             String                @map("batch_id") @db.Uuid
  batch               LandedCostImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Currently-linked product (the initial auto-match, or a different product
  // the user picked instead, or the product just created for this row).
  productId           String?               @map("product_id") @db.Uuid
  product             Product?              @relation(fields: [productId], references: [id])
  itemCode            String                @map("item_code")
  productName         String                @map("product_name")
  quantity            Int
  cartonCount         Int?                  @map("carton_count")
  // China fixed-template fields (nullable for legacy generic batches).
  piecesPerCarton     Int?                  @map("pieces_per_carton")
  unitPriceCny        Decimal?              @map("unit_price_cny") @db.Decimal(12, 4)
  cartonCbm           Decimal?              @map("carton_cbm") @db.Decimal(12, 4)
  cartonCostUsd       Decimal?              @map("carton_cost_usd") @db.Decimal(12, 4)
  unitCostUsd         Decimal?              @map("unit_cost_usd") @db.Decimal(12, 4)
  purchasePrice       Decimal               @map("purchase_price") @db.Decimal(12, 2)
  allocatedExtraCost  Decimal               @default(0) @map("allocated_extra_cost") @db.Decimal(12, 2)
  landedCostPerUnit   Decimal               @default(0) @map("landed_cost_per_unit") @db.Decimal(12, 2)
  landedCostPerCarton Decimal?              @map("landed_cost_per_carton") @db.Decimal(12, 2)
  suggestedSalePrice  Decimal?              @map("suggested_sale_price") @db.Decimal(12, 2)
  // Editable in the review step; required before Apply when action=CREATE_NEW.
  confirmedSalePrice  Decimal?              @map("confirmed_sale_price") @db.Decimal(12, 2)
  expectedProfit      Decimal?              @map("expected_profit") @db.Decimal(12, 2)
  // Initial system match result at parse time — immutable historical record.
  matchStatus         LandedCostMatchStatus @default(NOT_FOUND) @map("match_status")
  // Mutable user decision made in the review step.
  action              LandedCostItemAction  @default(PENDING)
  // New-product fields (name/barcode/category/pcsPerCarton/imageUrl overrides)
  // captured only when action=CREATE_NEW. Free-form JSON to avoid a wide,
  // mostly-empty column set.
  newProductDraft     Json?                 @map("new_product_draft")
  /// Set once this row has become real stock — its product exists and its
  /// line is on a purchase invoice. A shipment can land in parts, so this is
  /// per row and not per batch, and it is also the concurrency claim: two
  /// confirms racing on the same row, only one wins the UPDATE.
  appliedAt           DateTime?             @map("applied_at")
  createdAt           DateTime              @default(now()) @map("created_at")

  @@index([batchId])
  @@index([productId])
  @@map("landed_cost_import_items")
}

model LicensedClient {
