// ── Instagram auto-publish for «كتلوك المفرد» ────────────────────────────────
// Videos are stored in Postgres (MediaAsset.bytes) because Railway app disks are
// ephemeral; Meta pulls media from a public tokenized URL served by the backend.

enum InstagramPostStatus {
  DRAFT // prepared, saved by MANAGE_INSTAGRAM (no publish right) or explicitly saved
  QUEUED // waiting inside a scheduled queue
  PREPARING // جاري التجهيز — building Meta containers
  UPLOADING // جاري الرفع — containers created, waiting/publishing
  PUBLISHED // تم النشر
  FAILED // فشل — errorMessage holds the reason
}

enum InstagramPostType {
  IMAGE
  CAROUSEL
  REEL
}

enum InstagramQueueStatus {
  ACTIVE
  PAUSED
  DONE
}

enum InstagramScheduleType {
  FIXED_TIMES // explicit clock times (Baghdad time)
  INTERVAL // every N minutes
}

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String   @default("video")
  mime        String
  sizeBytes   Int      @map("size_bytes")
  duration    Float?
  width       Int?
  height      Int?
  bytes       Bytes
  publicToken String   @unique @default(uuid()) @map("public_token")
  createdAt   DateTime @default(now()) @map("created_at")

  retailItem RetailCatalogItem?

  @@map("media_assets")
}

model InstagramAccount {
  id                String    @id @default(uuid()) @db.Uuid
  igUserId          String    @unique @map("ig_user_id")
  username          String
  name              String?
  profilePictureUrl String?   @map("profile_picture_url")
  // AES-256-GCM encrypted long-lived token (see utils/crypto.ts)
  accessTokenEnc    String    @map("access_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  pageId            String?   @map("page_id")
  pageName          String?   @map("page_name")
  status            String    @default("connected") // connected | error | disconnected
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  posts  InstagramPost[]
  queues InstagramQueue[]

  @@map("instagram_accounts")
}

model InstagramQueue {
  id              String                @id @default(uuid()) @db.Uuid
  accountId       String                @map("account_id") @db.Uuid
  account         InstagramAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String?
  status          InstagramQueueStatus  @default(ACTIVE)
  scheduleType    InstagramScheduleType @map("schedule_type")
  // FIXED_TIMES: ["09:00","18:30"] Baghdad time. INTERVAL: intervalMinutes.
  times           String[]              @default([])
  intervalMinutes Int?                  @map("interval_minutes")
  postsPerDay     Int                   @default(1) @map("posts_per_day")
  publishedToday  Int                   @default(0) @map("published_today")
  todayKey        String?               @map("today_key") // Baghdad YYYY-MM-DD for publishedToday reset
  lastPublishedAt DateTime?             @map("last_published_at")
  createdById     String?               @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  posts InstagramPost[]

  @@index([status])
  @@map("instagram_queues")
}

model InstagramPost {
  id           String              @id @default(uuid()) @db.Uuid
  retailItemId String?             @map("retail_item_id") @db.Uuid
  retailItem   RetailCatalogItem?  @relation(fields: [retailItemId], references: [id], onDelete: SetNull)
  productTitle String              @map("product_title") // snapshot, survives item deletion
  accountId    String              @map("account_id") @db.Uuid
  account      InstagramAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  queueId      String?             @map("queue_id") @db.Uuid
  queue        InstagramQueue?     @relation(fields: [queueId], references: [id], onDelete: SetNull)
  position     Int                 @default(0)
  postType     InstagramPostType   @map("post_type")
  status       InstagramPostStatus @default(DRAFT)
  caption      String              @default("")
  // Ordered media plan chosen in the prep modal:
  // { media: [{ kind: "image", imageIndex: 0 } | { kind: "video" }], coverImageIndex?: number }
  mediaPlan    Json                @map("media_plan")
  igCreationId String?             @map("ig_creation_id") // container id — stored ASAP for idempotent retry
  igMediaId    String?             @map("ig_media_id") // published media id — stored ASAP, retry never double-posts
  permalink    String?
  errorMessage String?             @map("error_message")
  attemptCount Int                 @default(0) @map("attempt_count")
  publishedAt  DateTime?           @map("published_at")
  createdById  String?             @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([retailItemId])
  @@index([queueId, position])
  @@map("instagram_posts")
}

model InstagramHashtagGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  category  String?
  hashtags  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instagram_hashtag_groups")
}

/// One redemption of loyalty points for invoice discount.
///
/// Points are deducted the moment this row is written, inside the same
/// transaction as the invoice that consumes them — so a balance can never be
/// spent twice, and an invoice can never carry a discount nobody paid for.
model LoyaltyRedemption {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  /// Points taken off the customer's balance.
  points     Int
  /// What they were worth in dinars at the rate on the day — frozen, because
  /// the rate is a setting and changing it must not rewrite history.
  value      Decimal   @db.Decimal(12, 2)
  /// The rate used, kept so an old redemption can always be explained.
  pointValue Decimal   @map("point_value") @db.Decimal(12, 4)
  /// The invoice this discounted. Deliberately not a relation with a cascade:
  /// deleting an invoice must not silently erase the record of points spent.
  invoiceId  String?   @map("invoice_id") @db.Uuid
  note       String?
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Set when the invoice was cancelled and the points were handed back.
  revertedAt DateTime? @map("reverted_at")

  @@index([customerId, createdAt])
  @@index([invoiceId])
  @@map("loyalty_redemptions")
}
