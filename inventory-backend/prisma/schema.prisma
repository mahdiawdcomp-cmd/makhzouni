generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum PaymentType {
  CASH
  CREDIT
  PARTIAL
}

enum InvoiceStatus {
  ACTIVE
  CANCELLED
}

enum Unit {
  PIECE
  DOZEN
  BOX
  CARTON
}

enum VoucherType {
  RECEIPT
  PAYMENT
  EXPENSE
}

enum InvoiceType {
  SALE
  PURCHASE
  SALES_RETURN
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PromoCodeType {
  PERCENT
  AMOUNT
  FREE_DELIVERY
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  DAMAGE
}

enum LossReason {
  DAMAGE
  EXPIRY
  THEFT
  DEFECT
  // Physical count differed from the system's book quantity with no damage/
  // theft/expiry involved — e.g. the original recorded stock was itself wrong.
  // Valid for both directions: a shrinkage (LOSS) or a surplus (GAIN) found
  // during a manual adjustment, stocktake, or cycle count.
  COUNT_ERROR
  OTHER
}

// Whether a stock correction reduced recognized profit (LOSS — stock turned
// out lower than the books said) or added to it (GAIN — stock turned out
// higher, e.g. units were sold that were never recorded as received). Default
// LOSS keeps all pre-existing stock_losses rows (created only by the manual
// "خسائر/تلف" flow, which can only ever reduce stock) semantically unchanged.
enum StockLossDirection {
  LOSS
  GAIN
}

// Which flow produced a stock_losses row — lets reports/UI distinguish
// deliberate loss reports from automatic corrections. Default MANUAL keeps
// pre-existing rows unchanged.
enum StockLossSource {
  MANUAL
  ADJUST_STOCK
  CYCLE_COUNT
  STOCKTAKE
}

enum CatalogStockFilter {
  ALL_PRODUCTS
  FULL_CARTON_ONLY
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StocktakeSessionStatus {
  OPEN
  SUBMITTED
  CLOSED
}

enum StocktakeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// "جدولة الجرد الذكي" (scheduled smart cycle count) — fully independent from
// the manual StocktakeSession/StocktakeItem models above. Do not merge them.
enum CycleCountSessionStatus {
  OPEN
  SUBMITTED
  CLOSED
  CANCELLED
}

enum CycleCountSessionSource {
  MANUAL
  SCHEDULED
}

enum CycleCountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CycleCountStrategy {
  RANDOM
  HIGH_VALUE
  FAST_MOVING
  LOW_STOCK
  LEAST_RECENTLY_COUNTED
}

enum RetailOrderStatus {
  PENDING
  PROCESSING
  FAILED
  PREPARED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  DONE
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  API_ACCEPTED
  DELIVERED
  FAILED
  SKIPPED
  UNCONFIRMED
  // Legacy: rows created before the delivery-aware statuses existed. New code
  // never writes SENT — it means only "API accepted", now API_ACCEPTED.
  SENT
}

enum ErrorLogSource {
  CAMPAIGN
  WHATSAPP
  CRON
  BACKUP
  DATABASE
  API
  OTHER
}

enum ErrorLogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum ProspectStatus {
  NEW
  CONVERTED
}

enum InboundMessageSource {
  CUSTOMER_UNMATCHED
  PROSPECT
  UNKNOWN
}

enum WhatsappMessageDirection {
  IN
  OUT
}

enum InboundMessageStatus {
  UNREAD
  READ
  REPLIED
}

enum OrderPreparationStatus {
  PENDING
  CANCELLED
  PREPARED
}

enum LandedCostBatchStatus {
  DRAFT_PRICED
  REVIEWING_ITEMS
  /// Priced and reviewed, but the shipment is still on its way. Nothing is on
  /// the books yet — no purchase invoice, no stock — and the rows are showing
  /// on the storefront as «البضاعة القادمة» for customers to reserve.
  AWAITING_ARRIVAL
  PURCHASE_INVOICE_CREATED
  CANCELLED
}

enum LandedCostMatchStatus {
  MATCHED
  NOT_FOUND
  AMBIGUOUS
}

enum LandedCostAllocationMethod {
  BY_QUANTITY
  BY_VALUE
  BY_CARTON
}

enum LandedCostItemAction {
  PENDING
  LINK_EXISTING
  CREATE_NEW
  SKIP
}

model StockLoss {
  id              String             @id @default(uuid()) @db.Uuid
  lossNumber      String             @unique @map("loss_number")
  date            DateTime
  warehouseId     String             @map("warehouse_id") @db.Uuid
  warehouse       Branch             @relation("StockLossWarehouse", fields: [warehouseId], references: [id])
  reason          LossReason         @default(DAMAGE)
  direction       StockLossDirection @default(LOSS)
  source          StockLossSource    @default(MANUAL)
  notes           String?            @db.Text
  cancelledAt     DateTime?          @map("cancelled_at")
  createdBy       String             @map("created_by") @db.Uuid
  creator         User               @relation("StockLossCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  items           StockLossItem[]
  stockMovements  StockMovement[]
  cycleCountItems CycleCountItem[]   @relation("CycleCountItemLoss")
  stocktakeItems  StocktakeItem[]    @relation("StocktakeItemLoss")

  @@index([date])
  @@index([warehouseId])
  @@map("stock_losses")
}

model StockLossItem {
  id             String    @id @default(uuid()) @db.Uuid
  lossId         String    @map("loss_id") @db.Uuid
  loss           StockLoss @relation(fields: [lossId], references: [id], onDelete: Cascade)
  productId      String    @map("product_id") @db.Uuid
  product        Product   @relation("StockLossItems", fields: [productId], references: [id])
  productName    String    @map("product_name")
  unit           Unit
  quantity       Int
  // Piece count frozen at loss time (quantity × pcsPerCarton as-of the loss).
  // Nullable for legacy rows; the report falls back to a live re-computation for
  // those. Freezing it stops historical loss valuations from silently changing
  // when a product's pcsPerCarton is later edited.
  quantityPieces Int?      @map("quantity_pieces")
  costPrice      Decimal?  @map("cost_price") @db.Decimal(12, 2)

  @@index([lossId])
  @@index([productId])
  @@map("stock_loss_items")
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  name                      String
  username                  String                  @unique
  passwordHash              String                  @map("password_hash")
  // Bumped on password change and on explicit logout. Every issued JWT carries
  // the value it was signed with; authMiddleware rejects a token whose version
  // is stale, so changing the password actually revokes existing sessions.
  tokenVersion              Int                     @default(0) @map("token_version")
  role                      UserRole                @default(STAFF)
  // Free-form capability strings (see frontend UserPermission union). Also carries
  // DENY markers such as "HIDE_PROFIT_REPORTS" which revoke a capability even from an
  // ADMIN — see canViewProfitReports() in permission.middleware.ts. No migration is
  // needed to introduce new markers; this is intentionally an open String[].
  permissions               String[]                @default([])
  phone                     String?
  isActive                  Boolean                 @default(true) @map("is_active")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  products                  Product[]               @relation("ProductCreatedBy")
  invoices                  Invoice[]               @relation("InvoiceCreatedBy")
  paymentVouchers           PaymentVoucher[]        @relation("PaymentVoucherCreatedBy")
  coupons                   Coupon[]                @relation("CouponCreatedBy")
  quotations                Quotation[]             @relation("QuotationCreatedBy")
  requestedApprovals        PendingApproval[]       @relation("ApprovalRequestedBy")
  reviewedApprovals         PendingApproval[]       @relation("ApprovalReviewedBy")
  auditLogs                 AuditLog[]
  branches                  Branch[]
  createdTransfers          InventoryTransfer[]     @relation("TransferCreatedBy")
  preparedOrders            OrderPreparation[]      @relation("PreparedByUser")
  stocktakeSessions         StocktakeSession[]
  stockLosses               StockLoss[]             @relation("StockLossCreatedBy")
  landedCostBatchesCreated  LandedCostImportBatch[] @relation("LandedCostBatchCreatedBy")
  landedCostBatchesApplied  LandedCostImportBatch[] @relation("LandedCostBatchAppliedBy")
  cycleCountSessionsCreated CycleCountSession[]     @relation("CycleCountSessionCreatedBy")
  cycleCountItemsApproved   CycleCountItem[]        @relation("CycleCountItemApprovedBy")
  personalDebtsCreated      PersonalDebt[]
  // «المندوب» — customers assigned to this rep, and the sales/receipts credited
  // to them. Stamped from day one even while a single rep exists: adding an
  // identity to historical rows later is painful, leaving it in costs nothing.
  assignedCustomers         Customer[]              @relation("CustomerSalesAgent")
  salesAgentInvoices        Invoice[]               @relation("InvoiceSalesAgent")
  salesAgentVouchers        PaymentVoucher[]        @relation("PaymentVoucherSalesAgent")

  @@map("users")
}

model Branch {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String
  code               String                  @unique
  phone              String?
  address            String?
  isActive           Boolean                 @default(true) @map("is_active")
  createdBy          String?                 @map("created_by") @db.Uuid
  creator            User?                   @relation(fields: [createdBy], references: [id])
  products           Product[]
  productStocks      ProductWarehouseStock[]
  invoiceItems       InvoiceItem[]           @relation("InvoiceItemWarehouse")
  customers          Customer[]
  invoices           Invoice[]
  paymentVouchers    PaymentVoucher[]
  stockMovements     StockMovement[]
  transfersOut       InventoryTransfer[]     @relation("TransfersOut")
  transfersIn        InventoryTransfer[]     @relation("TransfersIn")
  stocktakeSessions  StocktakeSession[]
  stockLosses        StockLoss[]             @relation("StockLossWarehouse")
  cycleCountSessions CycleCountSession[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("branches")
}

model Product {
  id                    String                       @id @default(uuid()) @db.Uuid
  itemNumber            String                       @unique @map("item_number")
  name                  String
  qrCode                String                       @unique @map("qr_code")
  cartonQrCode          String?                      @unique @map("carton_qr_code")
  imageUrl              String?                      @map("image_url") @db.Text
  thumbnailUrl          String?                      @map("thumbnail_url") @db.Text
  /// Gallery-sized copy (~500px). Generated lazily the first time «المعرض»
  /// asks for it, so no migration has to walk every product and a product
  /// added later needs nobody to remember anything.
  mediumUrl             String?                      @map("medium_url") @db.Text
  category              String?
  openingBalancePcs     Int                          @default(0) @map("opening_balance_pcs")
  cartonsAvailable      Int                          @default(0) @map("cartons_available")
  pcsPerCarton          Int                          @default(1) @map("pcs_per_carton")
  purchasePrice         Decimal                      @default(0) @map("purchase_price") @db.Decimal(12, 2)
  salePrice             Decimal                      @default(0) @map("sale_price") @db.Decimal(12, 2)
  retailPrice           Decimal                      @default(0) @map("retail_price") @db.Decimal(12, 2)
  costPrice             Decimal                      @default(0) @map("cost_price") @db.Decimal(12, 2)
  expiryDate            DateTime?                    @map("expiry_date")
  minStock              Int                          @default(0) @map("min_stock")
  currentStock          Int                          @map("current_stock") @ignore
  storageLocation       String?                      @map("storage_location")
  branchId              String?                      @map("branch_id") @db.Uuid
  branch                Branch?                      @relation(fields: [branchId], references: [id])
  createdBy             String                       @map("created_by") @db.Uuid
  creator               User                         @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  invoiceItems          InvoiceItem[]
  quotationItems        QuotationItem[]
  stockMovements        StockMovement[]
  transferItems         TransferItem[]
  stocktakeItems        StocktakeItem[]
  cycleCountItems       CycleCountItem[]
  warehouseStocks       ProductWarehouseStock[]
  retailItems           RetailCatalogItem[]          @relation("RetailItemProduct")
  stockLossItems        StockLossItem[]              @relation("StockLossItems")
  arrivalSubscriptions  ProductArrivalSubscription[]
  landedCostImportItems LandedCostImportItem[]
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  deletedAt             DateTime?                    @map("deleted_at")

  // Multi-category & type tags (stored as PostgreSQL text arrays)
  categoryTags String[] @default([]) @map("category_tags")
  typeTags     String[] @default([]) @map("type_tags")

  // Wholesale catalog merchandising flags (mirror the retail catalog):
  // "new arrival" + "on offer" with an optional pre-offer price to strike through.
  isNewArrival Boolean   @default(false) @map("is_new_arrival")
  isOffer      Boolean   @default(false) @map("is_offer")
  oldPrice     Decimal?  @map("old_price") @db.Decimal(12, 2)
  // Optional deadline for isOffer. Drives the storefront countdown; null
  // means the offer simply has no end date, not that it has expired.
  offerEndsAt  DateTime? @map("offer_ends_at")

  // Unit configuration. Stock stays piece-based; these only drive
  // conversion/display. boxPieces null = automatic (half the carton,
  // rounded up); a value + isBoxPiecesManual means the shop overrode it.
  // hiddenUnits are soft-deleted units: blocked on NEW invoice lines only.
  boxPieces         Int?    @map("box_pieces")
  isBoxPiecesManual Boolean @default(false) @map("is_box_pieces_manual")
  hiddenUnits       Unit[]  @default([]) @map("hidden_units")

  // Storefront content for the wholesale catalog's product page. Kept apart
  // from the operational fields above: this is marketing copy the shop writes
  // for shoppers, and it is optional everywhere.
  catalogDescription String?                @map("catalog_description") @db.Text
  // [{ label, value }] — free-form spec rows rendered as a table.
  catalogSpecs       Json?                  @map("catalog_specs")
  catalogImages      ProductCatalogImage[]
  catalogReviews     CatalogProductReview[]

  @@index([createdBy])
  @@index([branchId])
  @@index([deletedAt])
  @@map("products")
}

// Extra storefront images for a product, beyond the single operational
// imageUrl/thumbnailUrl. Same storage approach as products.image_url (a data
// URI in a Text column) so the shop uploads from a phone with no external
// hosting — thumbnails are what the gallery lists, full images load on tap.
model ProductCatalogImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String   @db.Text
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([productId, sortOrder])
  @@map("product_catalog_images")
}

// Storefront reviews on the wholesale catalog's product page. Deliberately
// NOT the existing ProductReview model: that one is a single rating per sale
// INVOICE gathered over WhatsApp, which cannot be attributed to any one
// product. This is per-product, written by the shopper on the product page.
//
// Only wholesale customers with a catalog link can post, and nothing reaches
// the storefront until an admin approves it. The unique pair keeps one review
// per customer per product (re-submitting edits their own, back to PENDING).
model CatalogProductReview {
  id         String              @id @default(uuid()) @db.Uuid
  productId  String              @map("product_id") @db.Uuid
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String              @map("customer_id") @db.Uuid
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?             @db.Text
  status     ProductReviewStatus @default(PENDING)
  reviewedBy String?             @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?           @map("reviewed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("catalog_product_reviews")
}

// A Branch row is kept for API compatibility, but represents a warehouse
// inside the single shop. Product stock is stored separately per warehouse.
model ProductWarehouseStock {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String   @map("warehouse_id") @db.Uuid
  warehouse       Branch   @relation(fields: [warehouseId], references: [id])
  quantityPieces  Int      @default(0) @map("quantity_pieces")
  storageLocation String?  @map("storage_location")
  minStock        Int?     @map("min_stock")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_warehouse_stocks")
}

// Predefined catalog categories with their sub-types
model CatalogCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  types     String[] @default([])
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("catalog_categories")
}

// Generic sequence counters (item-number generator, etc.)
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("counters")
}

model Customer {
  id                              String                       @id @default(uuid()) @db.Uuid
  name                            String
  phone                           String                       @unique
  address                         String?
  notes                           String?
  isSupplier                      Boolean                      @default(false) @map("is_supplier")
  isBoth                          Boolean                      @default(false) @map("is_both")
  tags                            String[]                     @default([])
  catalogLinkSentAt               DateTime?                    @map("catalog_link_sent_at")
  openingBalance                  Decimal                      @default(0) @map("opening_balance") @db.Decimal(12, 2)
  currentBalance                  Decimal                      @default(0) @map("current_balance") @db.Decimal(12, 2)
  creditLimit                     Decimal?                     @map("credit_limit") @db.Decimal(12, 2)
  lastTransactionAt               DateTime?                    @map("last_transaction_at")
  branchId                        String?                      @map("branch_id") @db.Uuid
  branch                          Branch?                      @relation(fields: [branchId], references: [id])
  // Earn-only loyalty balance: 10 points per 1,000 IQD of PROFIT (not invoice
  // total) on each ACTIVE sale invoice — see Invoice.loyaltyPointsEarned for the
  // per-invoice snapshot this running total is built from. No redemption engine
  // yet — the owner decides/announces discounts manually using this number.
  loyaltyPoints                   Int                          @default(0) @map("loyalty_points")
  /// Excluded from loyalty entirely — earns nothing and cannot redeem. For
  /// collection accounts like «الزبون النقدي», which are a till and not a
  /// person: points piling up there reward nobody and inflate the liability.
  loyaltyExcluded                 Boolean                      @default(false) @map("loyalty_excluded")
  loyaltyRedemptions              LoyaltyRedemption[]
  // ── Storefront login ────────────────────────────────────────────────
  // The customer signs in with their phone plus a 6-digit code. Only the
  // bcrypt hash is stored, exactly like staff passwords — so a code can be
  // re-sent only by generating a fresh one, never by reading the old one back.
  accessCodeHash                  String?                      @map("access_code_hash")
  accessCodeSetAt                 DateTime?                    @map("access_code_set_at")
  lastLoginAt                     DateTime?                    @map("last_login_at")
  // A 6-digit code is a small keyspace, so throttling is what actually keeps
  // it safe: 5 failures locks the account for 15 minutes.
  failedLoginCount                Int                          @default(0) @map("failed_login_count")
  lockedUntil                     DateTime?                    @map("locked_until")
  // Per-customer override of the shop-wide "show prices" default.
  catalogPricesHidden             Boolean                      @default(false) @map("catalog_prices_hidden")
  // ── WhatsApp funnel: auto-tags + region-based delivery message ─────────
  // Free-form governorate name (fixed dropdown list on the frontend). Drives
  // the automatic "محافظات"/province tags and the delivery line shown on the
  // storefront and in WhatsApp messages. Optional — many existing customers
  // won't have it, and it's never required to create a customer.
  province                        String?
  // STATIONERY / TOYS / MIXED — optional, admin-entered for now until the
  // WhatsApp registration conversation (بند ٥) can ask for it directly.
  businessType                    String?                      @map("business_type")
  // بند ٨ — two independent automatic follow-ups, each fired at most once
  // ever per customer. Deliberately separate from inactiveCustomerDays /
  // autoSendInactiveMessage above (those stay alert-only; these two send
  // automatically, by explicit user decision).
  registeredNoOrderFollowUpSentAt DateTime?                    @map("registered_no_order_follow_up_sent_at")
  inactiveFollowUpSentAt          DateTime?                    @map("inactive_follow_up_sent_at")
  /// «كنت قريب» — last time this customer was nudged that their order fell
  /// just short of an offer. One marker, so the nudge cannot repeat every day.
  tierNudgeSentAt                 DateTime?                    @map("tier_nudge_sent_at")
  invoices                        Invoice[]
  paymentVouchers                 PaymentVoucher[]
  couponRedemptions               CouponRedemption[]
  quotations                      Quotation[]
  notifications                   Notification[]
  portalLinks                     CustomerPortalLink[]
  catalogAccessLinks              CatalogAccessLink[]
  arrivalSubscriptions            ProductArrivalSubscription[]
  promoCodes                      PromoCode[]
  productReviews                  ProductReview[]
  catalogReviews                  CatalogProductReview[]
  // ── «المندوب» ────────────────────────────────────────────────────────
  // The rep this customer belongs to. This column — NOT a tag — is what the
  // server filters on: tags are free text any user with customer-edit rights
  // can retype, and a typo there would open or close a customer's full account
  // statement by accident. A display tag is kept in sync alongside it purely so
  // the owner can see the link in the ordinary customers screen.
  salesAgentId                    String?                      @map("sales_agent_id") @db.Uuid
  salesAgent                      User?                        @relation("CustomerSalesAgent", fields: [salesAgentId], references: [id])
  // Area/neighbourhood INSIDE the city — distinct from `province` above, which
  // is the governorate. The rep works one city, so the governorate never varies
  // and the area is what actually identifies where a shop sits. Picked from a
  // per-tenant list held in settings (salesAgentAreas), never free text.
  area                            String?
  createdAt                       DateTime                     @default(now()) @map("created_at")
  updatedAt                       DateTime                     @updatedAt @map("updated_at")
  deletedAt                       DateTime?                    @map("deleted_at")

  @@index([branchId])
  @@index([lastTransactionAt])
  @@index([salesAgentId])
  @@map("customers")
}

// Potential / lead customers (زبائن محتملين) imported from contact lists or
// WhatsApp screenshots. Kept COMPLETELY SEPARATE from real shop customers — a
// prospect only becomes a Customer when the owner taps "convert" (after a sale).
model Prospect {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String         @unique
  address               String?
  source                String? // e.g. "vcf", "screenshot", "paste"
  status                ProspectStatus @default(NEW)
  convertedCustomerId   String?        @map("converted_customer_id") @db.Uuid
  lastSentAt            DateTime?      @map("last_sent_at")
  // Set once the auto-reply sent them the WhatsApp group invite link, so we
  // never spam the same prospect with the link twice.
  groupLinkSentAt       DateTime?      @map("group_link_sent_at")
  // بند ٨ — "ما ردّ" follow-up. Once-ever, regardless of how many campaigns
  // later re-target this prospect.
  noReplyFollowUpSentAt DateTime?      @map("no_reply_follow_up_sent_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("prospects")
}

// WhatsApp messages from numbers the auto-reply bot couldn't fully handle on
// its own — a known customer asking something outside the 4 fixed commands,
// a prospect, or a totally unknown number. Shown in a "الرسائل الواردة" inbox
// so the owner can read and reply by hand from the website.
model InboundMessage {
  id          String               @id @default(uuid()) @db.Uuid
  phone       String
  name        String?
  source      InboundMessageSource
  messageText String               @map("message_text")
  status      InboundMessageStatus @default(UNREAD)
  replyText   String?              @map("reply_text")
  repliedAt   DateTime?            @map("replied_at")
  // بند ٥ — set when the sender asked to talk to a human ("أريد أحچي مع
  // موظف") during the registration bot. Surfaced as a badge in the inbox.
  urgent      Boolean              @default(false)
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([status])
  @@map("inbound_messages")
}

// بند ٥ — one row per WhatsApp number mid-registration-conversation. Mirrors
// TelegramBotChat's state-machine pattern (a JSON blob + a `mode` field
// inside it), but for the "الاسم + المحافظة + نوع المحل" intake flow that
// ends in a CATALOG_ACCESS approval request. No FK to Customer/Prospect —
// this is pre-customer by definition, and the row is cleared once the
// conversation finishes or expires.
model WhatsappBotChat {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique
  state     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_bot_chats")
}

// Full two-way WhatsApp conversation log (Meta Cloud API "messenger" screen) —
// completely separate from InboundMessage above (which only logs messages the
// bot couldn't auto-answer). Every outbound send (manual reply, bot reply,
// invoice/campaign notification) and every inbound webhook message is logged
// here via whatsapp-chat.service.ts's logChatMessage(), so a conversation
// thread mirrors the real WhatsApp chat for that phone number.
model WhatsappConversation {
  id              String                   @id @default(uuid()) @db.Uuid
  phone           String                   @unique
  contactName     String?                  @map("contact_name")
  customerId      String?                  @map("customer_id") @db.Uuid
  lastMessageAt   DateTime                 @default(now()) @map("last_message_at")
  lastMessageText String?                  @map("last_message_text")
  lastDirection   WhatsappMessageDirection @map("last_direction")
  unreadCount     Int                      @default(0) @map("unread_count")
  // Conversation management — archive out of the default list, pin to the
  // top, and a staff-only note thread never sent to the customer.
  isArchived      Boolean                  @default(false) @map("is_archived")
  isPinned        Boolean                  @default(false) @map("is_pinned")
  internalNotes   String?                  @map("internal_notes") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")
  messages        WhatsappMessage[]

  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id                 String                   @id @default(uuid()) @db.Uuid
  conversationId     String                   @map("conversation_id") @db.Uuid
  conversation       WhatsappConversation     @relation(fields: [conversationId], references: [id])
  direction          WhatsappMessageDirection
  // Always populated even for media-only messages (readable fallback label,
  // e.g. "📷 صورة") so the conversation list preview never shows blank.
  text               String
  // Non-text content (image/document/audio/video/sticker/location received from
  // Meta, or a PDF/image WE sent). NULL mediaType = plain text message. Media
  // bytes are stored inline as a base64 data URL — same convention as product
  // images (productImageSchema) — no separate file storage/CDN for this feature.
  mediaType          String?                  @map("media_type")
  mediaDataUrl       String?                  @map("media_data_url") @db.Text
  mediaFilename      String?                  @map("media_filename")
  mediaMimeType      String?                  @map("media_mime_type")
  waMessageId        String?                  @unique @map("wa_message_id")
  // Delivery lifecycle from Meta status webhooks: SENT → DELIVERED → READ,
  // or FAILED (statusError then holds Meta's human-readable reason).
  status             String                   @default("SENT")
  statusError        String?                  @map("status_error")
  // Reply/quote: the quoted message's wa id + a denormalized text snapshot so
  // the quote block renders even when the original is outside the loaded page.
  replyToWaMessageId String?                  @map("reply_to_wa_message_id")
  replyToText        String?                  @map("reply_to_text")
  // Latest emoji reaction on this message (either side); null = none/removed.
  reactionEmoji      String?                  @map("reaction_emoji")
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

// Drip marketing campaign — sends a randomized message to a list of recipients
// over time (random message variant + random gap + random daily cap) to mimic
// human behaviour and avoid WhatsApp bans. Recipients are typically new
// customers (tag "new") imported from screenshots.
model Campaign {
  id                       String              @id @default(uuid()) @db.Uuid
  name                     String
  status                   CampaignStatus      @default(DRAFT)
  // One of these is picked at random for each message sent.
  messages                 String[]            @default([])
  // Optional product images to attach (first message carries them + catalog link).
  productIds               String[]            @default([]) @map("product_ids")
  includeCatalogLink       Boolean             @default(true) @map("include_catalog_link")
  // Cloud API pre-approved template (required for cold/first-contact sends —
  // Meta rejects free-text business-initiated messages outside the 24h session).
  useTemplate              Boolean             @default(false) @map("use_template")
  templateName             String?             @map("template_name")
  templateLanguage         String?             @default("ar") @map("template_language")
  // Static {{1}}..{{n}} values for the template body, same for every recipient
  // (e.g. an offer name/date) — a template send with unfilled variables is
  // rejected outright by Meta, so this must be set whenever the template has any.
  templateBodyParams       String[]            @default([]) @map("template_body_params")
  // بند ٥ — appends "رد 1 للشراء / 2 للكروب" to the text body (non-template
  // sends only; a template's buttons are configured in Meta, not here).
  // Off by default so campaigns unrelated to the registration funnel are
  // never silently changed.
  offerRegistrationChoices Boolean             @default(false) @map("offer_registration_choices")
  // Randomization windows.
  minDelaySec              Int                 @default(90) @map("min_delay_sec")
  maxDelaySec              Int                 @default(240) @map("max_delay_sec")
  dailyMin                 Int                 @default(20) @map("daily_min")
  dailyMax                 Int                 @default(50) @map("daily_max")
  activeStartHour          Int                 @default(9) @map("active_start_hour")
  activeEndHour            Int                 @default(21) @map("active_end_hour")
  // Worker bookkeeping (randomized per day).
  dailyCapToday            Int                 @default(0) @map("daily_cap_today")
  sentToday                Int                 @default(0) @map("sent_today")
  dayAnchor                DateTime?           @map("day_anchor")
  lastSentAt               DateTime?           @map("last_sent_at")
  nextSendAt               DateTime?           @map("next_send_at")
  recipients               CampaignRecipient[]
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  @@map("campaigns")
}

// A phone that asked to stop receiving MARKETING.
//
// Keyed by phone rather than by customer, because the same request can come
// from a prospect, a catalog visitor or a customer — and it has to hold even
// if that number later becomes a customer, or stops being one.
//
// This blocks campaigns and follow-ups ONLY. Invoices, statements, vouchers
// and login codes still go out: those are the shop answering a transaction
// the customer started, not advertising they opted out of.
model MarketingOptOut {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique
  // What they actually typed, so the shop can see why the number is blocked.
  reason    String?
  // "WHATSAPP_REPLY" when the customer sent the stop word, "ADMIN" when set
  // by hand from the dashboard.
  source    String   @default("WHATSAPP_REPLY")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("marketing_opt_outs")
}

model CampaignRecipient {
  id                 String                  @id @default(uuid()) @db.Uuid
  campaignId         String                  @map("campaign_id") @db.Uuid
  campaign           Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone              String
  name               String?
  status             CampaignRecipientStatus @default(PENDING)
  sentAt             DateTime?               @map("sent_at")
  error              String?
  variantUsed        String?                 @map("variant_used")
  // Provider tracking + retry bookkeeping (added 2026-07-02).
  messageId          String?                 @map("message_id") // provider idMessage (Green API) / messages[0].id (Cloud)
  providerResponse   Json?                   @map("provider_response") // raw provider payload for debugging
  failureCode        String?                 @map("failure_code") // structured code, e.g. GREENAPI_SEND_FAILED
  retryCount         Int                     @default(0) @map("retry_count")
  retryLastAttemptAt DateTime?               @map("retry_last_attempt_at")
  processedAt        DateTime?               @map("processed_at") // when the row was last dequeued for sending
  createdAt          DateTime                @default(now()) @map("created_at")

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// System error log for the "الأخطاء المحللة بالذكاء" admin page. Errors are
// GROUPED by (source, code, message) while unresolved — count is incremented
// instead of inserting a new row — so the table never grows without bound.
// Cleaned up after 90 days by a daily cron.
model ErrorLog {
  id          String         @id @default(uuid()) @db.Uuid
  source      ErrorLogSource
  level       ErrorLogLevel  @default(ERROR)
  code        String?
  message     String
  context     Json?
  count       Int            @default(1)
  firstSeenAt DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime       @default(now()) @map("last_seen_at")
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([source, resolvedAt])
  @@index([lastSeenAt])
  @@index([createdAt])
  @@map("error_logs")
}

// Canonical list of customer tags, so a tag can be created and managed
// independently of whether any customer currently carries it. The actual
// assignment still lives in Customer.tags (a string array).
model CustomerTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_tags")
}

model CustomerPortalLink {
  id           String    @id @default(uuid()) @db.Uuid
  token        String    @unique
  tokenHash    String    @unique @map("token_hash")
  customerId   String    @map("customer_id") @db.Uuid
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastViewedAt DateTime? @map("last_viewed_at")

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_portal_links")
}

model CatalogAccessLink {
  id                 String             @id @default(uuid()) @db.Uuid
  token              String             @unique
  tokenHash          String             @unique @map("token_hash")
  customerId         String             @map("customer_id") @db.Uuid
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allowPrices        Boolean            @default(false) @map("allow_prices")
  showStock          Boolean            @default(true) @map("show_stock")
  // Display filter per customer: FULL_CARTON_ONLY hides products with less than
  // one full carton in stock (the historical behavior); ALL_PRODUCTS shows every
  // in-stock product. Ordering stays carton-only regardless of this flag.
  catalogStockFilter CatalogStockFilter @default(FULL_CARTON_ONLY) @map("catalog_stock_filter")
  revokedAt          DateTime?          @map("revoked_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  lastViewedAt       DateTime?          @map("last_viewed_at")
  // Cumulative count of catalog opens by this customer (grid loads), unlike
  // lastViewedAt which only keeps the most recent timestamp.
  viewCount          Int                @default(0) @map("view_count")
  // Last successful OTP verification for this link. NULL or older than 6 months
  // means the shopper must re-verify by OTP; the token itself never expires.
  lastVerifiedAt     DateTime?          @map("last_verified_at")

  @@index([customerId])
  @@map("catalog_access_links")
}

// Guest catalog phone gate: when OTP is OFF, a visitor must enter their phone
// number once (per device) before browsing. Each phone is stored once and its
// visit counter increments on repeat entries so the merchant can follow up.
model CatalogVisitor {
  id               String   @id @default(uuid()) @db.Uuid
  phone            String   @unique
  visits           Int      @default(1)
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  // Accumulated across all visits, via a client heartbeat while the catalog
  // tab is visible — see catalog.service.ts recordVisitorHeartbeat().
  totalTimeSeconds Int      @default(0) @map("total_time_seconds")

  // ── Storefront login for someone who is not a customer yet ──────────
  // A visitor gets the same phone + 6-digit code as a real customer, so the
  // shop can send credentials to every number it knows. On first sign-in they
  // fill in their details, which go to the approvals queue — the Customer row
  // is only created once an admin approves it, so the shop still controls who
  // becomes a customer.
  accessCodeHash     String?   @map("access_code_hash")
  accessCodeSetAt    DateTime? @map("access_code_set_at")
  lastLoginAt        DateTime? @map("last_login_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  detailsSubmittedAt DateTime? @map("details_submitted_at")

  // ── Who they are ────────────────────────────────────────────────────
  // Held HERE, not in an approvals row, because a visitor is now a real
  // standing identity: they browse, they order, and they may never become a
  // shop customer at all. Promoting them to a Customer is a deliberate press
  // of «احفظ كزبون بالمحل», never a side effect of signing in.
  name         String?
  address      String?
  notes        String?
  province     String?
  businessType String? @map("business_type")

  // Browsing session, issued at sign-in. Separate from CatalogAccessLink on
  // purpose: that table's token is bound to a Customer row by a non-null FK,
  // and inventing a Customer just to hand out a token is exactly what this
  // whole change exists to stop.
  sessionTokenHash String?   @map("session_token_hash")
  sessionIssuedAt  DateTime? @map("session_issued_at")

  // Wholesale prices stay hidden until the shop says otherwise — the visitor
  // asks with «اطلب عرض سعر» and an admin approves. Null = still hidden.
  pricesUnlockedAt DateTime? @map("prices_unlocked_at")
  /// Explicitly closed for this visitor, whatever the shop-wide default says.
  /// Together with pricesUnlockedAt this makes three states — closed, opened,
  /// or "whatever the shop currently does" — which is what lets the merchant
  /// open prices to everyone and still shut one person out.
  pricesHidden     Boolean   @default(false) @map("prices_hidden")
  // Set while a price request is waiting, so the button can show its state
  // and a second request cannot pile another row onto the queue.
  priceRequestedAt DateTime? @map("price_requested_at")

  // The Customer this visitor was promoted into, if it ever happened. Keeps
  // the storefront account list honest about who is already on the books.
  customerId String? @map("customer_id") @db.Uuid

  @@index([sessionTokenHash])
  @@map("catalog_visitors")
}

// Per-visitor product-view log (distinct from CatalogProductStat below, which
// is an anonymous store-wide counter) — lets the owner see exactly which
// products a specific visitor opened, not just how many total views a
// product got. Written alongside CatalogProductStat's increment, not instead
// of it.
/// «البضاعة القادمة الجديدة» — goods the shop has bought but not received.
///
/// Curated by hand rather than read off a landed-cost batch: those batches are
/// a costing workflow, and a customer-facing list should never depend on where
/// the shop is in its own paperwork. No stock is touched — reserving is a
/// promise to sell, recorded against an item that does not exist yet.
model CatalogIncomingItem {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  /// Base64 data URI, same as products carry.
  imageUrl          String?   @map("image_url")
  /// Roughly when it lands. Null when the shop would rather not commit.
  expectedAt        DateTime? @map("expected_at")
  /// Optional — a shop may want reservations before it has settled a price.
  price             Decimal?  @db.Decimal(12, 2)
  active            Boolean   @default(true)
  sortOrder         Int       @default(0) @map("sort_order")
  /// Set when the shipment actually lands. Also hides the item from the
  /// storefront — a reservation list is about goods that have not arrived.
  arrivedAt         DateTime? @map("arrived_at")
  /// How much is on the way and how many to a carton, so the storefront can
  /// say «راح يوصل ٥٠ كارتون» instead of leaving the shopper to guess whether
  /// the shipment even covers what they want to reserve.
  quantityPieces    Int?      @map("quantity_pieces")
  pcsPerCarton      Int?      @map("pcs_per_carton")
  category          String?
  /// Set when this row was raised automatically from a China order that has
  /// not landed. Deliberately plain ids, not relations: a batch may be
  /// cancelled or pruned long after, and none of that should cascade into a
  /// list customers have already reserved against.
  sourceBatchId     String?   @map("source_batch_id") @db.Uuid
  sourceBatchItemId String?   @map("source_batch_item_id") @db.Uuid
  /// The real product this became, once it exists. Lets the arrival message
  /// carry a link straight to it. Deliberately not a relation: the product may
  /// be created, renamed or deleted long after, and none of that should
  /// cascade into a historical reservation list.
  productId         String?   @map("product_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  reservations CatalogIncomingReservation[]

  @@index([active, sortOrder])
  @@index([sourceBatchId])
  @@map("catalog_incoming_items")
}

model CatalogIncomingReservation {
  id        String              @id @default(uuid()) @db.Uuid
  itemId    String              @map("item_id") @db.Uuid
  item      CatalogIncomingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Who asked. Kept as a phone rather than a customer link, because a visitor
  /// who is not on the books can reserve too.
  phone     String
  name      String?
  quantity  Int                 @default(1)
  note      String?
  /// PENDING → CONFIRMED once the shop agrees, CANCELLED if it cannot.
  status    String              @default("PENDING")
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([itemId, phone])
  @@index([status])
  @@map("catalog_incoming_reservations")
}

/// One browsing visit. The visitor row keeps a running total; this keeps the
/// individual sessions behind it, so «شوكت طب» can be answered with a date and
/// a duration instead of just a counter.
///
/// Rows are opened and extended by the heartbeat rather than by an explicit
/// "visit started" event: the storefront already sends one while the tab is
/// visible, and inventing a second signal would give two sources of truth for
/// the same fact.
model CatalogVisitSession {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String
  startedAt  DateTime @default(now()) @map("started_at")
  /// Last heartbeat received; the visit is considered over once these stop.
  lastBeatAt DateTime @default(now()) @map("last_beat_at")
  seconds    Int      @default(0)

  @@index([phone, startedAt])
  @@map("catalog_visit_sessions")
}

model CatalogVisitorProductView {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String
  productId   String   @map("product_id")
  productName String   @map("product_name")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  @@index([phone, viewedAt])
  @@map("catalog_visitor_product_views")
}

// Per-product catalog engagement counters — how many times a product was
// opened (views) and how many catalog orders included it (orders). Powers the
// «تحليلات الكتلوك» admin view. Standalone (no FK) so a deleted product's
// historical counters survive; names are resolved by join at read time.
model CatalogProductStat {
  productId    String    @id @map("product_id") @db.Uuid
  views        Int       @default(0)
  orders       Int       @default(0)
  lastViewedAt DateTime? @map("last_viewed_at")

  @@map("catalog_product_stats")
}

model Invoice {
  id                  String                  @id @default(uuid()) @db.Uuid
  invoiceNumber       String                  @unique @map("invoice_number")
  type                InvoiceType             @default(SALE)
  customerId          String                  @map("customer_id") @db.Uuid
  customer            Customer                @relation(fields: [customerId], references: [id])
  branchId            String?                 @map("branch_id") @db.Uuid
  branch              Branch?                 @relation(fields: [branchId], references: [id])
  date                DateTime                @default(now())
  subtotal            Decimal                 @db.Decimal(12, 2)
  discount            Decimal                 @default(0) @db.Decimal(12, 2)
  tax                 Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal                 @map("total_amount") @db.Decimal(12, 2)
  paidAmount          Decimal                 @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount     Decimal                 @default(0) @map("remaining_amount") @db.Decimal(12, 2)
  previousBalance     Decimal                 @default(0) @map("previous_balance") @db.Decimal(12, 2)
  finalBalance        Decimal                 @default(0) @map("final_balance") @db.Decimal(12, 2)
  paymentType         PaymentType             @map("payment_type")
  status              InvoiceStatus           @default(ACTIVE)
  clientRequestId     String?                 @unique @map("client_request_id")
  couponId            String?                 @map("coupon_id") @db.Uuid
  coupon              Coupon?                 @relation(fields: [couponId], references: [id])
  originalInvoiceId   String?                 @map("original_invoice_id") @db.Uuid
  originalInvoice     Invoice?                @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id])
  returnInvoices      Invoice[]               @relation("InvoiceReturns")
  sourceQuotationId   String?                 @unique @map("source_quotation_id") @db.Uuid
  sourceQuotation     Quotation?              @relation("QuotationInvoice", fields: [sourceQuotationId], references: [id])
  createdBy           String                  @map("created_by") @db.Uuid
  creator             User                    @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  items               InvoiceItem[]
  stockMovements      StockMovement[]
  couponRedemptions   CouponRedemption[]
  preparation         OrderPreparation?
  landedCostBatches   LandedCostImportBatch[]
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now()) @map("created_at")
  // Bumped on every edit — /backup/changes selects on this. With createdAt
  // alone, edits to invoices older than the last full backup never reached
  // the incremental backup chain.
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at")
  // Accounting-safe deletion: rows are never physically removed. Archived
  // invoices are hidden from lists/reports but retained for audit.
  archivedAt          DateTime?               @map("archived_at")
  deletedBy           String?                 @map("deleted_by") @db.Uuid
  deleteReason        String?                 @map("delete_reason")
  // Origin channel ("TELEGRAM_BOT" | "WHATSAPP" | "PUBLIC_CATALOG" | ... ) —
  // free string, not an enum, matching how approval.service.ts already tags
  // requests. Null on legacy rows created before this column existed.
  source              String?
  // Loyalty points this SALE invoice earned at creation time (0 for
  // PURCHASE/SALES_RETURN). A frozen snapshot — not recomputed on edit — so
  // cancel/hardDelete can subtract exactly this back off Customer.loyaltyPoints
  // and reactivate/restore can add it back, without re-deriving profit.
  loyaltyPointsEarned Int                     @default(0) @map("loyalty_points_earned")
  // Set once the "قيّم مشترياتك" WhatsApp follow-up has been sent (2 days after
  // an ACTIVE sale) — guards the reminder cron against re-sending.
  ratingRequestedAt   DateTime?               @map("rating_requested_at")
  productReview       ProductReview?
  // «المندوب» — the rep this sale is credited to. Distinct from createdBy: the
  // invoice is created by whoever approves the catalog order (the owner), while
  // the sale belongs to the rep who took it in the market. The commission
  // screen reads this column and nothing else.
  salesAgentId        String?                 @map("sales_agent_id") @db.Uuid
  salesAgent          User?                   @relation("InvoiceSalesAgent", fields: [salesAgentId], references: [id])

  @@index([customerId])
  @@index([date])
  @@index([createdAt])
  @@index([customerId, date])
  @@index([source])
  @@index([createdBy])
  @@index([branchId])
  @@index([couponId])
  @@index([originalInvoiceId])
  @@index([archivedAt])
  @@index([updatedAt])
  @@index([salesAgentId])
  // Report/dashboard queries repeatedly filter status+type+date together
  // (getDashboardReport, getDailySummaryData, getProfitReport, StoreBrain).
  @@index([status, type, date])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String  @map("product_id") @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  warehouseId String? @map("warehouse_id") @db.Uuid
  warehouse   Branch? @relation("InvoiceItemWarehouse", fields: [warehouseId], references: [id])
  productName String  @map("product_name")
  // Snapshot of the product's item number at sale time, so old invoices still
  // show it after the product is soft-deleted. Nullable for legacy rows.
  itemNumber  String? @map("item_number")
  unit        Unit
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  notes       String? @db.Text
  // «تم تجهيز» — the picker ticked this line off while pulling the goods.
  // Purely operational: it never touches stock, money or the books, but it has
  // to survive a save so reopening the invoice shows what is left to pick.
  prepared    Boolean @default(false)

  @@index([invoiceId])
  @@index([productId])
  @@index([warehouseId])
  @@map("invoice_items")
}

model PaymentVoucher {
  id              String      @id @default(uuid()) @db.Uuid
  voucherNumber   String      @unique @map("voucher_number")
  // Client idempotency key: retries/double-submits of the same form return the
  // already-created voucher instead of creating a duplicate.
  clientRequestId String?     @unique @map("client_request_id")
  // Nullable: EXPENSE vouchers have no customer (e.g. generator fuel)
  customerId      String?     @map("customer_id") @db.Uuid
  customer        Customer?   @relation(fields: [customerId], references: [id])
  description     String? // free-text label, mainly for EXPENSE vouchers
  // Free string (not an enum) so the owner can type a new category without a
  // migration — UI offers a fixed suggested set (كهرباء/إيجار/رواتب/أخرى).
  // Only meaningful for type=EXPENSE; null on RECEIPT/PAYMENT vouchers.
  category        String?
  branchId        String?     @map("branch_id") @db.Uuid
  branch          Branch?     @relation(fields: [branchId], references: [id])
  amount          Decimal     @db.Decimal(12, 2)
  // Customer balance immediately BEFORE and AFTER this voucher, frozen at
  // creation exactly like Invoice.previousBalance/finalBalance. The WhatsApp
  // receipt used to re-derive these from the live balance, which was wrong for
  // any voucher that was not the customer's latest transaction.
  // NULL on vouchers created before this column existed.
  previousBalance Decimal?    @map("previous_balance") @db.Decimal(12, 2)
  finalBalance    Decimal?    @map("final_balance") @db.Decimal(12, 2)
  type            VoucherType
  date            DateTime    @default(now())
  notes           String?
  createdBy       String      @map("created_by") @db.Uuid
  creator         User        @relation("PaymentVoucherCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  // Same purpose as Invoice.updatedAt: cancellations/archives of old vouchers
  // must reach /backup/changes.
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  // Accounting-safe deletion: archived vouchers are retained for audit but
  // excluded from lists, reports, and balance calculations.
  archivedAt      DateTime?   @map("archived_at")
  deletedBy       String?     @map("deleted_by") @db.Uuid
  deleteReason    String?     @map("delete_reason")
  // «من استلم المبلغ» — the rep who physically took the cash, when it was not
  // handed over the counter. Purely an attribution stamp: the voucher still
  // credits the customer exactly as it always did, and nothing about the
  // existing accounting changes. The rep's outstanding cash is DERIVED from
  // these rows minus their handovers — never stored as a balance.
  salesAgentId    String?     @map("sales_agent_id") @db.Uuid
  salesAgent      User?       @relation("PaymentVoucherSalesAgent", fields: [salesAgentId], references: [id])

  @@index([customerId])
  @@index([date])
  @@index([createdAt])
  @@index([createdBy])
  @@index([branchId])
  @@index([archivedAt])
  @@index([updatedAt])
  @@index([salesAgentId])
  @@map("payment_vouchers")
}

// One overall rating per sale invoice, collected via a WhatsApp reply ~2 days
// after the sale (see notification-jobs.service.ts / whatsapp-bot.service.ts).
// A single rating per PURCHASE (the invoice's product set), not per line item —
// matches the simple "شنو تقيمك للمواد الي اشتريتها" flow, not a multi-turn
// per-product conversation.
model ProductReview {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @unique @map("invoice_id") @db.Uuid
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  // 1-5 when the reply parsed as a plain number/star count; null if the reply
  // was free text only (still stored as `comment` for the owner to read).
  rating     Int?
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("product_reviews")
}

model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  name          String
  discountType  DiscountType       @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(12, 2)
  startsAt      DateTime?          @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  maxUses       Int?               @map("max_uses")
  isActive      Boolean            @default(true) @map("is_active")
  createdBy     String             @map("created_by") @db.Uuid
  creator       User               @relation("CouponCreatedBy", fields: [createdBy], references: [id])
  invoices      Invoice[]
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  invoiceId  String   @map("invoice_id") @db.Uuid
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([couponId, invoiceId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @map("quotation_number")
  customerId      String          @map("customer_id") @db.Uuid
  customer        Customer        @relation(fields: [customerId], references: [id])
  status          QuotationStatus @default(PENDING)
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  expiresAt       DateTime?       @map("expires_at")
  notes           String?
  createdBy       String          @map("created_by") @db.Uuid
  creator         User            @relation("QuotationCreatedBy", fields: [createdBy], references: [id])
  invoice         Invoice?        @relation("QuotationInvoice")
  items           QuotationItem[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@index([createdBy])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  productName String    @map("product_name")
  unit        Unit
  quantity    Int
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal   @map("total_price") @db.Decimal(12, 2)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model PendingApproval {
  id          String         @id @default(uuid()) @db.Uuid
  requestType String         @map("request_type")
  requestData Json           @map("request_data")
  requestedBy String         @map("requested_by") @db.Uuid
  requester   User           @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  status      ApprovalStatus @default(PENDING)
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewer    User?          @relation("ApprovalReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?      @map("reviewed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([requestedBy])
  @@index([reviewedBy])
  @@index([status])
  @@map("pending_approvals")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  type       String
  message    String
  sentAt     DateTime? @map("sent_at")
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@map("notifications")
}

// In-app notification center (batch 23B foundation). SEPARATE from the legacy
// `Notification` model above (which is a customer WhatsApp/marketing log — do not
// merge). Additive only; not yet written to by any producer (invoice/whatsapp/
// transfer) — wiring comes in later batches (23D+).
model AppNotification {
  id              String    @id @default(uuid()) @db.Uuid
  type            String
  category        String
  severity        String
  title           String
  message         String
  // Role-based fan-out target: "ADMIN" | "STAFF" | "ALL" (nullable = untargeted).
  roleTarget      String?   @map("role_target")
  // Optional single-user target (takes precedence over roleTarget when set).
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  actionUrl       String?   @map("action_url")
  metadata        Json?
  // Dedupe grouping key (e.g. "type:entityId:YYYY-MM-DD"). Non-unique on purpose:
  // dedupe is resolved in the service against non-archived rows, so an archived
  // row never blocks a fresh one from being created with the same key.
  dedupeKey       String?   @map("dedupe_key")
  count           Int       @default(1)
  readAt          DateTime? @map("read_at")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([roleTarget, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([entityType, entityId])
  @@index([dedupeKey])
  @@map("app_notifications")
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  body      String
  type      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// «قناة تيليگرام» — public Telegram channel mirror of the wholesale catalog.
// Maps each published product to its channel message so the sync worker
// (telegram-channel.service) can edit/delete it later. Intentionally no FK to
// Product: a hard-deleted product must keep its row until the worker deletes
// the channel message, then removes the row itself. Uses its own bot — never
// the backup-delivery telegramBotToken settings.
model TelegramChannelPost {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @unique @map("product_id") @db.Uuid
  messageId   Int      @map("message_id")
  captionHash String   @map("caption_hash")
  imageHash   String   @default("") @map("image_hash")
  // Inline «اطلب» deep-link button under the post (Phase 2). false = published
  // before the button existed; the sync worker backfills it via
  // editMessageReplyMarkup.
  buttonAdded Boolean  @default(false) @map("button_added")
  publishedAt DateTime @default(now()) @map("published_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("telegram_channel_posts")
}

// «بوت تيليگرام» (Phase 2) — one row per Telegram user chatting with the bot.
// Holds the conversation state machine + cart + the phone/customer linkage so
// a returning customer never re-enters their number. Intentionally no FK to
// Customer (customer may be merged/deleted; bot just re-resolves by phone).
model TelegramBotChat {
  id         String   @id @default(uuid()) @db.Uuid
  chatId     BigInt   @unique @map("chat_id")
  firstName  String   @default("") @map("first_name")
  username   String   @default("")
  phone      String   @default("")
  customerId String?  @map("customer_id") @db.Uuid
  state      Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("telegram_bot_chats")
}

// Admin-composed broadcast: a channel post (optionally pinned) and/or a DM
// blast to every TelegramBotChat. Paced by runTelegramBroadcastTick (see
// telegram-broadcast.service), same throttling constants as the channel
// mirror worker.
model TelegramBroadcast {
  id               String                       @id @default(uuid()) @db.Uuid
  text             String
  imageDataUrl     String?                      @map("image_data_url")
  toChannel        Boolean                      @default(false) @map("to_channel")
  toBotUsers       Boolean                      @default(false) @map("to_bot_users")
  pinInChannel     Boolean                      @default(false) @map("pin_in_channel")
  status           String                       @default("PENDING") // PENDING | SENDING | DONE | FAILED
  channelMessageId Int?                         @map("channel_message_id")
  totalRecipients  Int                          @default(0) @map("total_recipients")
  sentCount        Int                          @default(0) @map("sent_count")
  createdById      String?                      @map("created_by") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  recipients       TelegramBroadcastRecipient[]

  @@map("telegram_broadcasts")
}

model TelegramBroadcastRecipient {
  id          String            @id @default(uuid()) @db.Uuid
  broadcastId String            @map("broadcast_id") @db.Uuid
  broadcast   TelegramBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  chatId      BigInt            @map("chat_id")
  status      String            @default("PENDING") // PENDING | SENT | FAILED
  sentAt      DateTime?         @map("sent_at")
  error       String?

  @@index([broadcastId, status])
  @@map("telegram_broadcast_recipients")
}

// «الديون الشخصية» — personal debts unrelated to shop customers/accounting
// (e.g. cash lent to a friend). Completely separate from Customer/Notification
// models above — do not merge. One admin-facing reminder flow: a daily cron
// (runPersonalDebtReminderJob) surfaces an AppNotification + WhatsApp message
// for every non-PAID row whose dueDate has arrived, repeating once per day
// (dedupeKey includes the day) until marked PAID.
model PersonalDebt {
  id          String    @id @default(uuid()) @db.Uuid
  personName  String    @map("person_name")
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime  @map("due_date")
  status      String    @default("PENDING") // PENDING | PAID (OVERDUE is derived: PENDING + dueDate in the past)
  notes       String?
  paidAt      DateTime? @map("paid_at")
  createdById String?   @map("created_by") @db.Uuid
  creator     User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, dueDate])
  @@index([createdById])
  @@map("personal_debts")
}

// Precomputed snapshots for the «المساعد الذكي اليومي» (Daily Smart Assistant).
// Heavy indicators are computed once each morning (kind=DAILY_HEAVY) and the
// basket "bought-together" analysis once a week (kind=WEEKLY_BASKET), so the
// assistant tab never recomputes them on open/refresh. Additive & isolated —
// never read by any existing report consumer. periodKey is the local-day/ISO
// week the snapshot is FOR; the @@unique keeps regeneration idempotent (upsert
// on kind+periodKey instead of inserting duplicate rows).
model AssistantSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String // "DAILY_HEAVY" | "WEEKLY_BASKET"
  periodKey     String   @map("period_key")
  schemaVersion Int      @default(1) @map("schema_version")
  data          Json
  generatedAt   DateTime @default(now()) @map("generated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([kind, periodKey])
  @@index([kind, generatedAt])
  @@map("assistant_snapshots")
}

model StockMovement {
  id            String             @id @default(uuid()) @db.Uuid
  productId     String             @map("product_id") @db.Uuid
  product       Product            @relation(fields: [productId], references: [id])
  branchId      String?            @map("branch_id") @db.Uuid
  branch        Branch?            @relation(fields: [branchId], references: [id])
  invoiceId     String?            @map("invoice_id") @db.Uuid
  invoice       Invoice?           @relation(fields: [invoiceId], references: [id])
  lossId        String?            @map("loss_id") @db.Uuid
  loss          StockLoss?         @relation(fields: [lossId], references: [id])
  transferId    String?            @map("transfer_id") @db.Uuid
  transfer      InventoryTransfer? @relation("TransferStockMovements", fields: [transferId], references: [id])
  type          StockMovementType
  quantity      Int
  balanceBefore Int                @map("balance_before")
  balanceAfter  Int                @map("balance_after")
  // Set only for manual stock adjustments (no invoice/loss/transfer) — records
  // who changed the quantity by hand, and an optional reason. Name is frozen at
  // write time so the log stays readable even if the user is later renamed.
  userId        String?            @map("user_id") @db.Uuid
  userName      String?            @map("user_name")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([invoiceId])
  @@index([branchId])
  @@index([lossId])
  @@index([transferId])
  @@map("stock_movements")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  recordId  String?  @map("record_id")
  before    Json?
  after     Json?
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@index([recordId])
  @@index([createdAt])
  // customer-statement lookups filter recordId IN (...) + entity IN (...) together.
  @@index([entity, recordId])
  @@map("audit_logs")
}

model InventoryTransfer {
  id              String          @id @default(uuid()) @db.Uuid
  transferNumber  String          @unique @map("transfer_number")
  fromBranchId    String          @map("from_branch_id") @db.Uuid
  fromBranch      Branch          @relation("TransfersOut", fields: [fromBranchId], references: [id])
  toBranchId      String          @map("to_branch_id") @db.Uuid
  toBranch        Branch          @relation("TransfersIn", fields: [toBranchId], references: [id])
  status          TransferStatus  @default(COMPLETED)
  date            DateTime        @default(now())
  notes           String?
  // Set only on the automatic depot→المحل transfer a depot sale generates.
  // Cancelling or hard-deleting that invoice reverses this transfer too;
  // without the link the total stock stayed correct but the depot was left
  // permanently short and المحل long, with nothing explaining why.
  sourceInvoiceId String?         @map("source_invoice_id") @db.Uuid
  createdBy       String          @map("created_by") @db.Uuid
  creator         User            @relation("TransferCreatedBy", fields: [createdBy], references: [id])
  items           TransferItem[]
  stockMovements  StockMovement[] @relation("TransferStockMovements")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([createdBy])
  @@index([status])
  @@index([sourceInvoiceId])
  @@map("inventory_transfers")
}

model TransferItem {
  id         String            @id @default(uuid()) @db.Uuid
  transferId String            @map("transfer_id") @db.Uuid
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String            @map("product_id") @db.Uuid
  product    Product           @relation(fields: [productId], references: [id])
  quantity   Int
  unit       Unit

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

model OrderPreparation {
  id            String                 @id @default(uuid()) @db.Uuid
  invoiceId     String?                @unique @map("invoice_id") @db.Uuid
  invoice       Invoice?               @relation(fields: [invoiceId], references: [id])
  customerName  String                 @map("customer_name")
  customerPhone String                 @map("customer_phone")
  items         Json
  orderData     Json?                  @map("order_data")
  notes         String?
  status        OrderPreparationStatus @default(PENDING)
  preparedAt    DateTime?              @map("prepared_at")
  preparedById  String?                @map("prepared_by_id") @db.Uuid
  preparedBy    User?                  @relation("PreparedByUser", fields: [preparedById], references: [id])
  createdAt     DateTime               @default(now()) @map("created_at")
  // Origin channel, same free-string convention as Invoice.source above.
  source        String?

  @@index([status])
  @@index([source])
  @@map("order_preparations")
}

// ── Retail Catalog (كتلوك المفرد) ─────────────────────────────────────────────
// A fully public, mobile-first retail storefront. Items reference a Product
// only to read its live piece-stock; all display data (images, price, title)
// is independent of the wholesale catalog.

model RetailCatalogItem {
  id                   String          @id @default(uuid()) @db.Uuid
  productId            String          @map("product_id") @db.Uuid
  product              Product         @relation("RetailItemProduct", fields: [productId], references: [id])
  title                String?
  description          String?
  price                Decimal         @db.Decimal(12, 2)
  oldPrice             Decimal?        @map("old_price") @db.Decimal(12, 2)
  categories           String[]        @default([])
  subCategories        String[]        @default([]) @map("sub_categories")
  images               Json            @default("[]")
  sortOrder            Int             @default(0) @map("sort_order")
  featured             Boolean         @default(false)
  isBestSeller         Boolean         @default(false) @map("is_best_seller")
  isNew                Boolean         @default(false) @map("is_new")
  isOffer              Boolean         @default(false) @map("is_offer")
  lowStockBadge        Boolean         @default(false) @map("low_stock_badge")
  isActive             Boolean         @default(true) @map("is_active")
  // Exactly ONE optional video per product (locked decision) — bytes live in MediaAsset.
  videoAssetId         String?         @unique @map("video_asset_id") @db.Uuid
  videoAsset           MediaAsset?     @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  // Instagram publish summary (fast display on the catalog admin grid);
  // full history lives in InstagramPost.
  instagramPublishedAt DateTime?       @map("instagram_published_at")
  instagramPermalink   String?         @map("instagram_permalink")
  instagramAccountName String?         @map("instagram_account_name")
  instagramPosts       InstagramPost[]
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([productId])
  @@map("retail_catalog_items")
}

model RetailCategory {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  subCategories String[] @default([]) @map("sub_categories")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("retail_categories")
}

model RetailCustomer {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String    @unique
  name         String
  isSubscriber Boolean   @default(false) @map("is_subscriber")
  interests    String[]  @default([])
  wishNote     String?   @map("wish_note")
  ordersCount  Int       @default(0) @map("orders_count")
  lastOrderAt  DateTime? @map("last_order_at")
  referralCode String?   @unique @map("referral_code")
  referredBy   String?   @map("referred_by")
  // Secret token so a customer can view their own orders via a private link
  // instead of exposing orders to anyone who knows the phone number (#5).
  ordersToken  String?   @unique @map("orders_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isSubscriber])
  @@map("retail_customers")
}

model RetailCoupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  startsAt      DateTime?    @map("starts_at")
  endsAt        DateTime?    @map("ends_at")
  maxUses       Int?         @map("max_uses")
